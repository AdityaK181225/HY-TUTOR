# HY-TUTOR Environment Variables
# Copy this file to config/.env and fill in your values.
# (The install script does this for you automatically.)
#
# Quick start:
#   bash install.sh         # Linux / macOS
#   powershell .\install.ps1  # Windows

# ----------------------------------------------------------------------------
# Google Gemini API Key (REQUIRED)
# ----------------------------------------------------------------------------
# Get yours for free at: https://aistudio.google.com/app/apikey
# The key looks like: AIzaSy... (about 39 characters)
GEMINI_API_KEY=
