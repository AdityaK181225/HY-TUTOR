[Desktop Entry]
Version=1.0
Type=Application
Terminal=true
Name=HY-TUTOR
GenericName=AI Study Engine
Comment=Launch HY-TUTOR Socratic Study Engine
Comment[en]=Launch HY-TUTOR Socratic Study Engine
# @EXEC@, @PATH@, and @ICON@ are placeholders patched by make_desktop.sh
# at install time with the absolute paths of the user's clone. Do not edit
# these values by hand — re-run bash make_desktop.sh after moving the repo.
Exec=@EXEC@
Path=@PATH@
Icon=@ICON@
Categories=Education;Development;Science;
StartupNotify=true
StartupWMClass=HY-TUTOR
Keywords=study;tutor;education;gemini;ai;
