# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file — applies to the whole repo.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{md,yaml,yml,json,toml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = lf
indent_size = 4

[Makefile]
indent_style = tab
